{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/histo-helper/:path*",
      "destination": "/diagnostika/rasshifrovka-gistologii/",
      "permanent": true
    },
    {
      "source": "/histo-helper",
      "destination": "/diagnostika/rasshifrovka-gistologii/",
      "permanent": true
    },
    {
      "source": "/articles/laparoscopic-cholecystectomy.html",
      "destination": "/articles/laparoscopic-cholecystectomy/",
      "permanent": true
    },
    {
      "source": "/articles/laparoscopy-preparation.html",
      "destination": "/guides/laparoscopy-preparation.html",
      "permanent": true
    },
    {
      "source": "/articles/myomectomy.html",
      "destination": "/myomectomy/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}